{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare-worker.mjs",
  "name": "iwish-sell-crm",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Cloudflare for SaaS via iwishapp.cn. Production DNS: sell.iwishweb.com CNAME customers.iwishapp.cn
  // Manage the exact sell.iwishweb.com/* route in the Cloudflare dashboard.
  "workers_dev": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_PUBLIC_URL": "https://sell.iwishweb.com",
    "NEXT_PUBLIC_SYSTEM_KEY": "crm",
    "NODE_VERSION": "24",
    "WECOM_GATEWAY_BASE_URL": "https://requirement.iwishweb.com",
    "WECOM_GATEWAY_SYSTEM_KEY": "crm",
    "WECOM_MESSAGE_PREFIX": "【销售线索系统】"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "iwish-sell-crm"
    }
  ]
}
